{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "ink",
					"name": "Chữ chính",
					"color": "#0E2A2F"
				},
				{
					"slug": "muted",
					"name": "Chữ phụ",
					"color": "#4B6468"
				},
				{
					"slug": "white",
					"name": "Trắng (nền)",
					"color": "#FFFFFF"
				},
				{
					"slug": "mist",
					"name": "Xám nhạt (nền phụ)",
					"color": "#F2F7F7"
				},
				{
					"slug": "teal",
					"name": "Teal (nút, liên kết)",
					"color": "#087A82"
				},
				{
					"slug": "teal-hover",
					"name": "Teal hover",
					"color": "#066A72"
				},
				{
					"slug": "teal-bright",
					"name": "Teal sáng (một mảng nền mỗi trang)",
					"color": "#19C6BE"
				},
				{
					"slug": "teal-deep",
					"name": "Teal đậm (chân trang)",
					"color": "#052E33"
				},
				{
					"slug": "teal-tint",
					"name": "Teal nhạt (nền biểu tượng)",
					"color": "#DCF2F1"
				},
				{
					"slug": "sun",
					"name": "Vàng ưu đãi (chỉ cho ưu đãi)",
					"color": "#FFC93C"
				},
				{
					"slug": "sun-tint",
					"name": "Vàng nhạt (nền ưu đãi)",
					"color": "#FFF6DA"
				},
				{
					"slug": "amber",
					"name": "Nâu hổ phách (chữ ưu đãi)",
					"color": "#8A5A00"
				},
				{
					"slug": "line",
					"name": "Đường kẻ",
					"color": "#E2ECEC"
				},
				{
					"slug": "line-strong",
					"name": "Đường kẻ đậm",
					"color": "#C9D8D8"
				},
				{
					"slug": "danger",
					"name": "Lỗi",
					"color": "#B42318"
				},
				{
					"slug": "success",
					"name": "Thành công",
					"color": "#067647"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Quang Đăng Sans (Google Sans Flex)",
					"fontFamily": "\"Quang Dang Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Quang Dang Sans",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/qd-sans.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Nhỏ",
					"size": "0.875rem"
				},
				{
					"slug": "base",
					"name": "Thường",
					"size": "1rem"
				},
				{
					"slug": "medium",
					"name": "Bài viết",
					"size": "1.125rem"
				},
				{
					"slug": "large",
					"name": "Lớn",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "Rất lớn",
					"size": "2rem"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%"
			],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "2.5rem"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "4rem"
				}
			]
		},
		"border": {
			"radius": false,
			"color": false,
			"style": false,
			"width": false
		},
		"shadow": {
			"defaultPresets": false
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--brand-600)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "650",
					"lineHeight": "1.3"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		}
	}
}
